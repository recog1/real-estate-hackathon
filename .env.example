# Optional. Used only by the header "3D view" button (Google Photorealistic 3D Tiles,
# Cesium ion asset 2275207). The main ASDA competitor demo — MapLibre map, Cesium
# globe, Esri World Imagery, satellite tasking, capture and verdict — works without it.
# Get a free token at https://ion.cesium.com, paste it below, and restart the dev server.
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# MSCI Real Capital Analytics — comps/transactions. Leave blank to use bundled sample data.
MSCI_API_KEY=

# Satellite tasking / scene search. Leave blank to use the bundled ASDA Leyton Mills capture.
SATELLITE_API_KEY=
SATELLITE_API_URL=
